{
  "name": "faster-cms-web",
  "version": "2.0.0",
  "private": true,
  "description": "Faster-CMS 后台管理前端（Ant Design Pro v5 / Umi 4 / antd 5）",
  "scripts": {
    "dev": "cross-env UMI_ENV=dev max dev",
    "mock": "cross-env UMI_ENV=dev MOCK=true max dev",
    "prod": "cross-env UMI_ENV=prod max build",
    "test": "cross-env UMI_ENV=test max build",
    "build": "max build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@umijs/max": "^4.7.32",
    "antd": "^5.29.3",
    "braft-editor": "^2.3.9",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.0",
    "less": "^4.9.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "antd": "$antd",
    "@ant-design/icons": "^5.6.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 11"
  ],
  "engines": {
    "node": ">=18"
  }
}
